	"styles": {
		"css": "",
		"elements": {
			"link": {
				":active": {
					"color": {
						"text": "var(--wp--preset--color--link-text)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--link-text)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--link-text)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
